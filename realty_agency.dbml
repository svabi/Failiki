// Агентство по недвижимости: аренда квартиры
// Вставьте весь текст на https://dbdiagram.io/d (слева) - диаграмма построится справа

Project realty_agency {
  database_type: 'PostgreSQL'
  Note: 'ЛР 11. Агентство по недвижимости - аренда квартиры'
}

Table district {
  district_id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table apartment_status {
  status_id int [pk, increment]
  name varchar(50) [not null, unique, note: 'Свободна / Сдана / На обслуживании']
}

Table owner {
  owner_id int [pk, increment]
  full_name varchar(150) [not null]
  phone varchar(20) [not null]
  email varchar(100)
}

Table tenant {
  tenant_id int [pk, increment]
  full_name varchar(150) [not null]
  phone varchar(20) [not null]
  email varchar(100)
  passport_no varchar(20) [not null, unique]
}

Table agent {
  agent_id int [pk, increment]
  full_name varchar(150) [not null]
  phone varchar(20) [not null]
  hire_date date [not null]
}

Table apartment {
  apartment_id int [pk, increment]
  owner_id int [not null]
  district_id int [not null]
  status_id int [not null]
  street varchar(100) [not null]
  house varchar(10) [not null]
  flat_no varchar(10)
  rooms smallint [not null]
  area_m2 decimal(6,2) [not null]
  floor smallint
  monthly_rent decimal(10,2) [not null]
}

Table amenity {
  amenity_id int [pk, increment]
  name varchar(80) [not null, unique, note: 'Мебель, кондиционер, парковка...']
}

Table apartment_amenity {
  apartment_id int [not null]
  amenity_id int [not null]
  indexes {
    (apartment_id, amenity_id) [pk]
  }
}

Table viewing {
  viewing_id int [pk, increment]
  apartment_id int [not null]
  tenant_id int [not null]
  agent_id int [not null]
  viewing_datetime timestamp [not null]
  result varchar(200)
}

Table lease_contract {
  contract_id int [pk, increment]
  apartment_id int [not null]
  tenant_id int [not null]
  agent_id int [not null]
  start_date date [not null]
  end_date date [not null]
  rent_amount decimal(10,2) [not null]
  deposit decimal(10,2) [not null, default: 0]
  commission decimal(10,2) [not null, default: 0]
}

Table payment_type {
  payment_type_id int [pk, increment]
  name varchar(50) [not null, unique, note: 'Аренда / Залог / Комиссия']
}

Table payment {
  payment_id int [pk, increment]
  contract_id int [not null]
  payment_type_id int [not null]
  payment_date date [not null]
  amount decimal(10,2) [not null]
}

// Связи (1:N)
Ref: apartment.owner_id > owner.owner_id
Ref: apartment.district_id > district.district_id
Ref: apartment.status_id > apartment_status.status_id

// Связь M:N через ассоциативную таблицу
Ref: apartment_amenity.apartment_id > apartment.apartment_id
Ref: apartment_amenity.amenity_id > amenity.amenity_id

Ref: viewing.apartment_id > apartment.apartment_id
Ref: viewing.tenant_id > tenant.tenant_id
Ref: viewing.agent_id > agent.agent_id

Ref: lease_contract.apartment_id > apartment.apartment_id
Ref: lease_contract.tenant_id > tenant.tenant_id
Ref: lease_contract.agent_id > agent.agent_id

Ref: payment.contract_id > lease_contract.contract_id
Ref: payment.payment_type_id > payment_type.payment_type_id
